# Copy this file to .env and fill in real values. .env is gitignored and
# should never be committed.

# SQLite for local dev. Prisma supports Postgres/MySQL/SQL Server/MongoDB
# connection strings too — see https://pris.ly/d/connection-strings
DATABASE_URL="file:./dev.db"

PORT=3001

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# USDA FoodData Central API key (free): https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Anthropic API key, used for AI recipe generation: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Used once by `npm run seed` to create your login. Set these to your own
# values, then you can blank SEED_PASSWORD back out after seeding if you want.
SEED_EMAIL=you@example.com
SEED_PASSWORD=change-me

# ── Supabase (web deployment only — leave ALL of these unset for the desktop
# app; with SUPABASE_URL unset every Supabase code path is inert) ──────────────

# Project URL — Supabase dashboard > Project Settings > General (also shown
# under Settings > API Keys). Looks like https://abcdefgh.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_...) — Settings > API Keys. BACKEND-ONLY: full access,
# bypasses Row Level Security. Never ships to the frontend, never committed.
# Not used yet (Stage 1 verifies JWTs against public keys); later stages use it.
SUPABASE_SECRET_KEY=

# ONLY if the project uses the legacy shared JWT secret instead of the current
# asymmetric signing keys. Leave unset on a new project — the backend then
# verifies tokens against the project's public JWKS endpoint, which is the
# right default.
SUPABASE_JWT_SECRET=

# ── Lemon Squeezy (web deployment only; all from the LS dashboard) ────────────
# API key: Settings > API. Store ID: Settings > Stores (the number in the URL
# works too). Variant IDs: open the product, each variant shows its ID.
# Webhook secret: the "Signing secret" you set when creating the webhook.
# TEST MODE keys/ids until Stage 6 — test and live are separate values.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_ANNUAL=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Stage 6 penny test ONLY: id of the hidden lowest-price variant. Visiting
# /?penny=1 signed-in checks out against it through the real pipeline
# (user_id custom data included). REMOVE after the penny test — with this
# unset the "penny" period is rejected.
LEMONSQUEEZY_VARIANT_PENNY=

# Public URL of the deployed app (no trailing slash) — used for the
# after-checkout redirect. Unset locally; the request Origin covers dev.
APP_URL=
