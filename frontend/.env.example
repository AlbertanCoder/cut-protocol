# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# WEB BUILD ONLY. Leave both unset (or have no .env at all) for the desktop
# app — without them the app keeps its local email/password sign-in and never
# touches Supabase.

# Supabase dashboard > Settings > API Keys
VITE_SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_...). Safe to expose in the bundle.
# NEVER put the secret key (sb_secret_...) in this file — that one is
# backend-only and lives in backend/.env.
VITE_SUPABASE_PUBLISHABLE_KEY=
