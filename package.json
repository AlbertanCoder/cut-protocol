{
  "name": "cut-protocol-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Cut Protocol — Windows desktop shell (Electron) around the existing Express+Prisma+React app.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:frontend": "npm --prefix frontend run build",
    "dist:template": "node backend/scripts/buildTemplateDb.mjs",
    "predist": "node backend/scripts/buildTemplateDb.mjs && node scripts/cleanBuildArtifacts.mjs && node scripts/distPrecheck.mjs",
    "dist": "npm run build:frontend && electron-builder",
    "dist:files": "node scripts/resolvePackagedFiles.mjs",
    "clean:artifacts": "node scripts/cleanBuildArtifacts.mjs",
    "scan:secrets": "node scripts/scanSecrets.mjs --tracked",
    "brain:purity": "node scripts/checkBrainPurity.mjs",
    "supply:check": "node scripts/checkSupplyChain.mjs",
    "security:all": "node scripts/scanSecrets.mjs --tracked && node scripts/checkBrainPurity.mjs && node scripts/checkSupplyChain.mjs",
    "dist:check": "node scripts/checkDistSafe.mjs",
    "release": "npm run build:frontend && electron-builder --publish always",
    "license:keygen": "node electron/licenseTool.cjs keygen"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cutprotocol.app",
    "productName": "Cut Protocol",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "package.json",
      "CutProtocol.ico",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/logger.cjs",
      "electron/license.cjs",
      "electron/updater.cjs",
      "electron/splash.html",
      "frontend/dist/**/*",
      "backend/package.json",
      "backend/server.js",
      "backend/src/**/*.js",
      "backend/src/**/*.mjs",
      "backend/data/foodOverrides.json",
      "backend/data/ingredientCosts.json",
      "backend/prisma/schema.prisma",
      "backend/prisma/migrations/**/*.sql",
      "backend/prisma/migrations/migration_lock.toml",
      "backend/node_modules/**/*",
      "!backend/node_modules/prisma{,/**/*}",
      "!backend/node_modules/@prisma/engines{,/**/*}",
      "!backend/node_modules/**/*.node.tmp*",
      "!backend/node_modules/**/.env*",
      "!backend/node_modules/**/*.db",
      "!backend/node_modules/**/*.sqlite",
      "!**/node_modules/.cache/**/*",
      "!**/*.test.js",
      "!**/*.map"
    ],
    "asarUnpack": [
      "backend/node_modules/.prisma/**/*",
      "backend/node_modules/@prisma/**/*",
      "backend/prisma/schema.prisma",
      "backend/prisma/migrations/**/*"
    ],
    "extraResources": [
      { "from": "backend/prisma/dev.db.template", "to": "dev.db.template" }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AlbertanCoder",
        "repo": "cut-protocol",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "CutProtocol.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cut Protocol"
    }
  }
}
